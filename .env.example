# --- Payload CMS -------------------------------------------------------------
# Local SQLite file (default). For production use Turso/libSQL:
#   DATABASE_URL=libsql://your-db.turso.io   DATABASE_AUTH_TOKEN=...
DATABASE_URL=file:./inhaus.db
DATABASE_AUTH_TOKEN=
# Any long random string (openssl rand -hex 32)
PAYLOAD_SECRET=change-me

# --- Shopify Storefront API (optional) ---------------------------------------
# Leave empty to run on the local demo catalog (src/lib/catalog.ts).
SHOPIFY_STORE_DOMAIN=3dxypz-fh.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2026-10

# --- Site --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
