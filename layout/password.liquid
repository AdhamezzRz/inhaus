<!doctype html>
<html lang="{{ request.locale.iso_code }}" data-theme="day">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }} — opening soon</title>
    <style>
      @font-face { font-family: 'IH Bodoni'; src: url({{ 'ih-bodoni-italic.woff2' | asset_url }}) format('woff2'); font-weight: 400 900; font-style: italic; font-display: swap; }
      @font-face { font-family: 'IH Archivo'; src: url({{ 'ih-archivo.woff2' | asset_url }}) format('woff2'); font-weight: 100 900; font-display: swap; }
      @font-face { font-family: 'IH Archivo Narrow'; src: url({{ 'ih-archivo-narrow-500.woff2' | asset_url }}) format('woff2'); font-weight: 500; font-display: swap; }
      :root { --monogram: url({{ 'monogram.svg' | asset_url }}); }
    </style>
    {{ 'inhaus.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="template-password">
    {% render 'wordmark-sprite' %}
    {{ content_for_layout }}
  </body>
</html>
