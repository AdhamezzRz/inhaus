<!doctype html>
<html lang="{{ request.locale.iso_code }}" data-theme="day"{% if request.design_mode %} data-design-mode{% endif %}>
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#F7F6F1">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'general.tagged' | t: tags: current_tags.first }}{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}
    {% render 'meta-tags' %}

    {{ 'ih-bodoni-italic.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {{ 'ih-archivo.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    <style>
      @font-face { font-family: 'IH Bodoni'; src: url({{ 'ih-bodoni.woff2' | asset_url }}) format('woff2'); font-weight: 400 900; font-style: normal; font-display: swap; }
      @font-face { font-family: 'IH Bodoni'; src: url({{ 'ih-bodoni-italic.woff2' | asset_url }}) format('woff2'); font-weight: 400 900; font-style: italic; font-display: swap; }
      @font-face { font-family: 'IH Archivo'; src: url({{ 'ih-archivo.woff2' | asset_url }}) format('woff2'); font-weight: 100 900; font-stretch: 62% 125%; font-display: swap; }
      @font-face { font-family: 'IH Archivo Narrow'; src: url({{ 'ih-archivo-narrow-400.woff2' | asset_url }}) format('woff2'); font-weight: 400; font-display: swap; }
      @font-face { font-family: 'IH Archivo Narrow'; src: url({{ 'ih-archivo-narrow-500.woff2' | asset_url }}) format('woff2'); font-weight: 500; font-display: swap; }
      :root { --monogram: url({{ 'monogram.svg' | asset_url }}); }
    </style>
    <script>
      try {
        var d = document.documentElement;
        var t = localStorage.getItem('innhaus-theme');
        if (t) d.dataset.theme = t;
        var calm = matchMedia('(prefers-reduced-motion: reduce)').matches || d.hasAttribute('data-design-mode');
        {%- if settings.show_preloader %}
        if (!calm && sessionStorage.getItem('innhaus-intro-seen') !== '1') d.classList.add('is-loading');
        {%- endif %}
        if (!calm && !d.classList.contains('is-loading') && sessionStorage.getItem('innhaus-curtain') === '1') d.classList.add('is-arriving');
        sessionStorage.removeItem('innhaus-curtain');
      } catch (e) {}
    </script>

    {{ 'inhaus.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name }}">
    <a class="skip-link sr-only" href="#main">Skip to content</a>
    {% render 'wordmark-sprite' %}

    {%- if settings.show_preloader -%}
      <div class="preloader" aria-hidden="true">
        <div class="preloader__pattern"></div>
        <div class="preloader__meta"><span>{{ shop.name }}</span><span>{{ settings.preloader_season }}</span></div>
        <div class="preloader__mark">
          {% render 'wordmark', write: true, uid: 'preloader', class: 'preloader__logo' %}
          <svg class="preloader__nibs" viewBox="0 0 900 442" aria-hidden="true">
            {% render 'pen-guides' %}
            <circle class="preloader__nib" r="0" cx="0" cy="0"/>
          </svg>
        </div>
        <p class="preloader__tag">
          {%- assign chars = settings.tagline | upcase | split: '' -%}
          {%- for c in chars -%}<span>{% if c == ' ' %}&nbsp;{% else %}{{ c }}{% endif %}</span>{%- endfor -%}
        </p>
        <div class="preloader__count">000</div>
      </div>
    {%- endif -%}

    <div class="curtain" aria-hidden="true">
      <div class="curtain__panel curtain__panel--l">{% for i in (1..7) %}<span class="curtain__fold"></span>{% endfor %}</div>
      <div class="curtain__panel curtain__panel--r">{% for i in (1..7) %}<span class="curtain__fold"></span>{% endfor %}</div>
      <div class="curtain__mark">{% render 'wordmark', write: true, uid: 'curtain', class: 'curtain__logo' %}</div>
    </div>

    {% sections 'header-group' %}

    <main id="main" role="main">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'cart-drawer' %}

    {%- if settings.show_lamp_cord -%}
      <div class="lampcord" data-cursor="pull">
        <svg class="lampcord__svg" width="40" height="260" viewBox="0 0 40 260" aria-hidden="true"><line x1="20" y1="0" x2="20" y2="120"/></svg>
        <button class="lampcord__tag" type="button" aria-label="Pull to switch the lights">
          <svg viewBox="0 0 40 44" aria-hidden="true">
            <path d="M20 42 C 9 33, 2 26, 2 16 A 9.5 9.5 0 0 1 20 10 A 9.5 9.5 0 0 1 38 16 C 38 26, 31 33, 20 42 Z"/>
            <circle cx="20" cy="7" r="2.2" class="lampcord__hole"/>
            <text x="20" y="27" text-anchor="middle">ih</text>
          </svg>
        </button>
      </div>
    {%- endif -%}

    {%- if settings.show_cursor -%}
      <div class="cursor" aria-hidden="true"><div class="cursor__btn"><i></i><i></i><i></i><i></i></div><span class="cursor__label"></span></div>
    {%- endif -%}
    <div class="grain" aria-hidden="true"></div>

    <script>
      window.InnHaus = {
        routes: {
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | append: '.js' | json }},
          cartChange: {{ routes.cart_change_url | append: '.js' | json }},
          cartJs: {{ routes.cart_url | append: '.js' | json }},
          root: {{ routes.root_url | json }}
        },
        moneyFormat: {{ shop.money_format | json }},
        currency: {{ cart.currency.iso_code | json }},
        freeShipping: {{ settings.free_shipping_threshold | default: 0 | times: 100 }},
        curtains: {{ settings.page_curtains | json }},
        smooth: {{ settings.smooth_scroll | json }},
        designMode: {{ request.design_mode | json }}
      };
    </script>
    <script src="{{ 'vendor-gsap.min.js' | asset_url }}" defer></script>
    <script src="{{ 'vendor-ScrollTrigger.min.js' | asset_url }}" defer></script>
    <script src="{{ 'vendor-SplitText.min.js' | asset_url }}" defer></script>
    <script src="{{ 'vendor-DrawSVGPlugin.min.js' | asset_url }}" defer></script>
    <script src="{{ 'vendor-MorphSVGPlugin.min.js' | asset_url }}" defer></script>
    <script src="{{ 'vendor-Draggable.min.js' | asset_url }}" defer></script>
    <script src="{{ 'vendor-InertiaPlugin.min.js' | asset_url }}" defer></script>
    <script src="{{ 'vendor-Flip.min.js' | asset_url }}" defer></script>
    <script src="{{ 'vendor-CustomEase.min.js' | asset_url }}" defer></script>
    <script src="{{ 'vendor-lenis.min.js' | asset_url }}" defer></script>
    <script src="{{ 'inhaus.js' | asset_url }}" defer></script>
  </body>
</html>
