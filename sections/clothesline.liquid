{%- liquid
  assign source = section.settings.collection
  if source == blank
    assign source = collections.all
  endif
-%}
<section class="line" data-header-tone="dark" data-section-type="clothesline">
  <div class="line__pin">
    <header class="line__head">
      <p class="t-caps">{{ section.settings.label }}</p>
      <h2 class="t-display" data-split="chars">{{ section.settings.title }}</h2>
      <p class="line__intro">{{ section.settings.intro }}</p>
    </header>
    <div class="line__viewport">
      <div class="line__track">
        <svg class="line__rope" height="160" aria-hidden="true"><path/></svg>
        {%- for product in source.products limit: section.settings.limit -%}
          {%- liquid
            if section.settings.skip_little_things and product.tags contains 'room:little-things'
              continue
            endif
            assign badge = ''
            if product.tags contains 'bestseller'
              assign badge = 'Bestseller'
            elsif product.tags contains 'new'
              assign badge = 'New'
            endif
          -%}
          <article class="peg-card" style="--i: {{ forloop.index0 }}">
            {% render 'peg' %}
            <a href="{{ product.url }}" class="peg-card__body" data-cursor="view">
              <span class="peg-card__frame">
                {%- if product.featured_media -%}
                  {{ product.featured_media | image_url: width: 700 | image_tag: loading: 'lazy', widths: '360,520,700', sizes: '(max-width: 560px) 66vw, 22vw', alt: product.featured_media.alt }}
                {%- endif -%}
                {%- if product.media[1] -%}
                  {{ product.media[1] | image_url: width: 700 | image_tag: loading: 'lazy', widths: '360,520,700', sizes: '(max-width: 560px) 66vw, 22vw', alt: '', class: 'peg-card__alt' }}
                {%- endif -%}
              </span>
              <span class="peg-card__room">{% render 'room-name', product: product %}</span>
              <span class="peg-card__title">{{ product.title }}</span>
              <span class="peg-card__price">{{ product.price | money_without_trailing_zeros }}</span>
              {%- if badge != '' -%}<span class="peg-card__badge">{{ badge }}</span>{%- endif -%}
            </a>
          </article>
        {%- endfor -%}
        <article class="peg-card peg-card--end">
          {% render 'peg' %}
          <a href="{{ source.url | default: routes.all_products_collection_url }}" class="peg-card__body peg-card__body--end" data-cursor="open">
            <span class="t-display">{{ section.settings.end_title }}</span>
            <span class="t-caps">Shop every piece →</span>
          </a>
        </article>
      </div>
    </div>
    <div class="line__thread" aria-hidden="true"><span></span></div>
  </div>
</section>

{% schema %}
{
  "name": "The line (product rail)",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "N° 03 — The line" },
    { "type": "text", "id": "title", "label": "Title", "default": "fresh off the line" },
    { "type": "text", "id": "intro", "label": "Intro", "default": "Pegged up this morning. Scroll along the line and take one down." },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Defaults to all products." },
    { "type": "range", "id": "limit", "label": "Products", "min": 4, "max": 16, "step": 1, "default": 12 },
    { "type": "checkbox", "id": "skip_little_things", "label": "Skip accessories (Little Things)", "default": true },
    { "type": "text", "id": "end_title", "label": "Last card title", "default": "the whole wardrobe" }
  ],
  "presets": [{ "name": "The line (product rail)" }]
}
{% endschema %}
