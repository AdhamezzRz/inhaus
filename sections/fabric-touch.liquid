<section class="fabric" data-header-tone="dark">
  <figure class="fabric__img">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'lazy', widths: '800,1200,1600,2000', sizes: '100vw', alt: section.settings.alt }}
    {%- else -%}
      <img src="{{ 'l-fabric.webp' | asset_url }}" alt="{{ section.settings.alt | escape }}" loading="lazy" width="1024" height="1024">
    {%- endif -%}
  </figure>
  <div class="fabric__copy" data-reveal>
    <p class="t-caps">{{ section.settings.label }}</p>
    <h2 class="t-display">{{ section.settings.title }}</h2>
    <p>{{ section.settings.text }}</p>
    <ul class="fabric__facts">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}><strong>{{ block.settings.value }}</strong><span>{{ block.settings.label }}</span></li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Fabric story",
  "max_blocks": 4,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Fabric close-up" },
    { "type": "text", "id": "alt", "label": "Image description", "default": "Close-up of sage and cream pinstripe cotton poplin" },
    { "type": "text", "id": "label", "label": "Label", "default": "N° 04 — The cloth" },
    { "type": "text", "id": "title", "label": "Title", "default": "feel the poplin" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Long-staple cotton, woven tight and brushed soft — it gets better every single wash." }
  ],
  "blocks": [
    { "type": "fact", "name": "Fact", "settings": [
      { "type": "text", "id": "value", "label": "Value", "default": "120" },
      { "type": "text", "id": "label", "label": "Label", "default": "gsm poplin" }
    ] }
  ],
  "presets": [{ "name": "Fabric story", "blocks": [
    { "type": "fact", "settings": { "value": "120", "label": "gsm poplin" } },
    { "type": "fact", "settings": { "value": "100%", "label": "long-staple cotton" } },
    { "type": "fact", "settings": { "value": "∞", "label": "washes softer" } }
  ] }]
}
{% endschema %}
