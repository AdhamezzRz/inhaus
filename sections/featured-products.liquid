{%- liquid
  assign picks = section.settings.products
  assign fallback = false
  if picks == blank or picks.count == 0
    assign fallback = true
  endif
-%}
<section class="erow" data-header-tone="dark">
  <header class="erow__head" data-reveal>
    <h2 class="ed-label">{{ section.settings.title }}</h2>
    <a class="ed-link" href="{{ routes.all_products_collection_url }}">{{ section.settings.button }}</a>
  </header>
  <div class="erow__track">
    {%- if fallback -%}
      {%- for product in collections.all.products limit: 5 -%}
        {% render 'product-card', product: product, sizes: '(max-width: 760px) 62vw, 20vw' %}
      {%- endfor -%}
    {%- else -%}
      {%- for product in picks -%}
        {% render 'product-card', product: product, sizes: '(max-width: 760px) 62vw, 20vw' %}
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product row",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "New in" },
    { "type": "text", "id": "button", "label": "Link text", "default": "View all" },
    { "type": "product_list", "id": "products", "label": "Products", "limit": 8 }
  ],
  "presets": [{ "name": "Product row" }]
}
{% endschema %}
