{%- liquid
  assign source = section.settings.collection
  if source == blank
    assign source = collections.all
  endif
  assign shown = 0
-%}
<section class="edit" data-header-tone="dark">
  <div class="section-head" data-reveal>
    <p class="t-caps">{{ section.settings.label }}</p>
    <h2 class="t-display">{{ section.settings.title }}</h2>
    <p class="section-head__lede">{{ section.settings.intro }}</p>
  </div>
  <div class="pgrid pgrid--edit">
    {%- for product in source.products -%}
      {%- if shown < section.settings.limit -%}
        {%- unless section.settings.skip_little_things and product.tags contains 'room:little-things' -%}
          {% render 'product-card', product: product, index: shown %}
          {%- assign shown = shown | plus: 1 -%}
        {%- endunless -%}
      {%- endif -%}
    {%- endfor -%}
  </div>
  <div class="edit__more" data-reveal>
    <a href="{{ source.url | default: routes.all_products_collection_url }}" class="btn btn--ghost"><span>{{ section.settings.button }}</span></a>
  </div>
</section>

{% schema %}
{
  "name": "The edit (products)",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "N° 02 — The edit" },
    { "type": "text", "id": "title", "label": "Title", "default": "soft things, chosen slowly" },
    { "type": "text", "id": "intro", "label": "Intro", "default": "Pieces made to be lived in — from the first coffee to the last episode." },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Defaults to all products." },
    { "type": "range", "id": "limit", "label": "Products", "min": 3, "max": 12, "step": 1, "default": 6 },
    { "type": "checkbox", "id": "skip_little_things", "label": "Skip accessories (Little Things)", "default": true },
    { "type": "text", "id": "button", "label": "Button", "default": "Shop the collection" }
  ],
  "presets": [{ "name": "The edit (products)" }]
}
{% endschema %}
