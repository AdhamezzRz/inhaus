<section class="efilm" data-header-tone="dark">
  <div class="efilm__copy" data-reveal>
    {%- if section.settings.label != blank -%}<p class="ed-label">{{ section.settings.label }}</p>{%- endif -%}
    <h2 class="ed-title">{{ section.settings.title }}</h2>
    {%- if section.settings.text != blank -%}<p class="efilm__text">{{ section.settings.text }}</p>{%- endif -%}
    {%- if section.settings.link_label != blank -%}<a class="ed-link" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.link_label }}</a>{%- endif -%}
  </div>
  <div class="efilm__frame" data-reveal>
    {%- if section.settings.video != blank -%}
      {{ section.settings.video | video_tag: autoplay: false, loop: true, muted: true, playsinline: true, controls: false, preload: 'none', image_size: '900x', data-film: '' }}
    {%- else -%}
      <video data-film muted loop playsinline preload="none" poster="{{ 'ih-film-poster.webp' | asset_url }}" width="720" height="1280">
        <source src="{{ 'ih-film.mp4' | asset_url }}" type="video/mp4">
      </video>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Film",
  "settings": [
    { "type": "video", "id": "video", "label": "Film", "info": "Leave empty to use the built-in INN HAUS reel." },
    { "type": "text", "id": "label", "label": "Small label", "default": "The film" },
    { "type": "text", "id": "title", "label": "Title", "default": "At home, in Inn Haus." },
    { "type": "text", "id": "text", "label": "Line" },
    { "type": "text", "id": "link_label", "label": "Link text", "default": "Shop the collection" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Film" }]
}
{% endschema %}
