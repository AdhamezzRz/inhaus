{%- assign menu = linklists[section.settings.menu] -%}
<footer class="efoot" data-header-tone="dark">
  <div class="efoot__join">
    <h2 class="ed-label">{{ section.settings.eyebrow }}</h2>
    {%- form 'customer', class: 'efoot__form', id: 'footer-newsletter' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label for="footer-email" class="sr-only">Email</label>
      <input id="footer-email" type="email" name="contact[email]" required placeholder="Your email" autocomplete="email">
      <button type="submit" class="ed-link">Join</button>
      {%- if form.posted_successfully? -%}
        <p class="efoot__msg">You’re on the list. Welcome in.</p>
      {%- elsif form.errors -%}
        <p class="efoot__msg">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>

  <nav class="efoot__links" aria-label="Footer">
    {%- for link in menu.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
    {%- for policy in shop.policies -%}<a href="{{ policy.url }}">{{ policy.title }}</a>{%- endfor -%}
    {%- if section.settings.instagram != blank -%}<a href="https://instagram.com/{{ section.settings.instagram }}" target="_blank" rel="noopener">Instagram</a>{%- endif -%}
    {%- if section.settings.tiktok != blank -%}<a href="https://tiktok.com/@{{ section.settings.tiktok }}" target="_blank" rel="noopener">TikTok</a>{%- endif -%}
    {%- if section.settings.email != blank -%}<a href="mailto:{{ section.settings.email }}">Contact</a>{%- endif -%}
  </nav>

  <a class="efoot__mark" href="{{ routes.root_url }}" aria-label="{{ shop.name }} — home">{% render 'wordmark' %}</a>

  <div class="efoot__base">
    <span>&copy; {{ 'now' | date: '%Y' }} {{ section.settings.name | default: shop.name }}</span>
    <span>{{ settings.tagline }}</span>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Newsletter title", "default": "Join the haus list" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" },
    { "type": "text", "id": "name", "label": "Name in the copyright line", "info": "Leave empty to use the store name." },
    { "type": "text", "id": "email", "label": "Contact email" },
    { "type": "text", "id": "instagram", "label": "Instagram handle" },
    { "type": "text", "id": "tiktok", "label": "TikTok handle" }
  ]
}
{% endschema %}
