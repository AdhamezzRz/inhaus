{%- comment -%}
  The logo window. A sage field with the INN HAUS script cut out of it; the film plays inside the letters.
  On the very first visit the logo writes itself in cream, then the ink "pours" into the film.
  Scrolling flies the camera into the thickest stroke of the "haus" until the film fills the screen.
  The viewBox (the camera) is set by window.IHHero, defined below so it is right before first paint.
{%- endcomment -%}
<section class="hero" data-header-tone="light" data-section-type="hero" aria-label="{{ section.settings.title | escape }}">
  <div class="hero__stage">
    <div class="hero__film">
      {%- if section.settings.video != blank -%}
        {{ section.settings.video | video_tag: autoplay: false, loop: true, muted: true, playsinline: true, controls: false, preload: 'auto', class: 'hero__video', image_size: '1600x' }}
      {%- else -%}
        <video class="hero__video" muted loop playsinline autoplay preload="auto" poster="{% if section.settings.poster != blank %}{{ section.settings.poster | image_url: width: 1800 }}{% else %}{{ 'l-hero.webp' | asset_url }}{% endif %}">
          <source src="{{ 'hero.webm' | asset_url }}" type="video/webm">
          <source src="{{ 'hero.mp4' | asset_url }}" type="video/mp4">
        </video>
      {%- endif -%}
    </div>
    <div class="hero__shade" aria-hidden="true"></div>

    <svg class="hero__veil" viewBox="0 0 2472 1272" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      <defs>
        <mask id="hero-pen" maskUnits="userSpaceOnUse" x="-100" y="-100" width="2672" height="1472">
          <g class="hero__pen" transform="scale(2.74667 2.74730)" fill="none" stroke="#fff" stroke-width="38" stroke-linecap="round" stroke-linejoin="round">{% render 'logo-pens' %}</g>
        </mask>
      </defs>
      <path class="hero__sage" fill-rule="evenodd" d="M-60000 -60000H62472V61272H-60000Z {% render 'logo-path' %}"/>
      <path class="hero__ink" fill-rule="evenodd" mask="url(#hero-pen)" d="{% render 'logo-path' %}"/>
    </svg>

    <div class="hero__meta">
      <span>{{ section.settings.eyebrow }}</span>
      <span>{{ section.settings.eyebrow_right }}</span>
    </div>

    {%- assign chars = section.settings.title | split: '' -%}
    <h1 class="hero__tagline" aria-label="{{ section.settings.title | escape }}">
      {%- for c in chars -%}<span aria-hidden="true" style="--i: {{ forloop.index0 }}">{% if c == ' ' %}&nbsp;{% else %}{{ c }}{% endif %}</span>{%- endfor -%}
    </h1>

    <p class="hero__caption t-display">{{ section.settings.caption }}</p>
    {%- if section.settings.cta_label != blank -%}
      <a class="hero__cta btn btn--cream" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">{{ section.settings.cta_label }}</a>
    {%- endif -%}

    <div class="hero__cue">
      <span class="hero__line" aria-hidden="true"></span>
      <span>{{ section.settings.cue }}</span>
    </div>
  </div>
</section>
<script>
  window.IHHero = function (stage, svg, p) {
    var W = stage.clientWidth, H = stage.clientHeight, m = W < 760, f = m ? 0.42 : 0.45;
    var lw = Math.min(m ? 0.86 * W : 0.62 * W, 1100, 1.1 * H);
    var ar = H / W, vb0 = 2472 * W / lw;
    var t = Math.min(1, Math.max(0, p / 0.8));
    var e = t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
    // end frame sits wholly inside the stroke around (1304, 878), where the ink is ~41 units thick
    var vb1 = (0.9 * 82) / Math.sqrt(1 + ar * ar);
    var z = vb0 * Math.pow(vb1 / vb0, e), k = z / vb0, zh = z * ar;
    var cx = 1304 + (1236 - 1304) * k, cy = 878 + (636 + (0.5 - f) * vb0 * ar - 878) * k;
    svg.setAttribute('viewBox', (cx - z / 2).toFixed(2) + ' ' + (cy - zh / 2).toFixed(2) + ' ' + z.toFixed(3) + ' ' + zh.toFixed(3));
    stage.style.setProperty('--logo-h', ((lw * 1272) / 2472).toFixed(1) + 'px');
    stage.style.setProperty('--logo-y', f * 100 + '%');
    stage.style.setProperty('--e', e.toFixed(4));
  };
  (function (s) { window.IHHero(s.querySelector('.hero__stage'), s.querySelector('.hero__veil'), 0); })(document.currentScript.previousElementSibling);
</script>

{% schema %}
{
  "name": "Hero — the logo window",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (left)", "default": "Fall 2026 — Loungewear for living in" },
    { "type": "text", "id": "eyebrow_right", "label": "Eyebrow (right)", "default": "N° 01 — The Day In edit" },
    { "type": "text", "id": "title", "label": "Tagline", "default": "wear it. live in it." },
    { "type": "text", "id": "caption", "label": "Caption once inside", "default": "Come in. Stay a while." },
    { "type": "text", "id": "cta_label", "label": "Button once inside", "default": "Shop the edit" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "text", "id": "cue", "label": "Scroll cue", "default": "Scroll to step inside" },
    { "type": "video", "id": "video", "label": "Video", "info": "Optional. Leave empty to use the built-in INN HAUS film." },
    { "type": "image_picker", "id": "poster", "label": "Poster image" }
  ],
  "presets": [{ "name": "Hero — the logo window" }]
}
{% endschema %}
