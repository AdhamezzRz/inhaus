{%- comment -%}
  The lookbook. A pinned, full-screen sequence: the film, then one scene per room.
  Each scene lifts into the next as you scroll — every movement is tied to the scroll
  position (one --t variable from inhaus.js); there are no keyframe animations.
{%- endcomment -%}
{%- assign scenes = section.blocks.size | plus: 1 -%}
<section class="look" data-header-tone="light" data-section-type="hero" style="--n: {{ scenes }}" aria-label="{{ section.settings.title | escape }}">
  <div class="look__stage">
    <div class="look__scene look__scene--film" style="--i: 0">
      <div class="look__media">
        <div class="look__fill">
          {%- if section.settings.video != blank -%}
            {{ section.settings.video | video_tag: autoplay: false, loop: true, muted: true, playsinline: true, controls: false, preload: 'auto', class: 'look__video', image_size: '1800x' }}
          {%- else -%}
            <video class="look__video" muted loop playsinline autoplay preload="auto" poster="{% if section.settings.poster != blank %}{{ section.settings.poster | image_url: width: 1800 }}{% else %}{{ 'l-hero.webp' | asset_url }}{% endif %}">
              <source src="{{ 'hero.webm' | asset_url }}" type="video/webm">
              <source src="{{ 'hero.mp4' | asset_url }}" type="video/mp4">
            </video>
          {%- endif -%}
        </div>
      </div>
      <div class="look__copy look__copy--film">
        <p class="look__label">{{ section.settings.eyebrow }}</p>
        {%- assign left = section.settings.title | split: '.' | first | append: '.' -%}
        {%- assign right = section.settings.title | remove_first: left | strip -%}
        <h1 class="look__title look__title--film">
          <span class="look__row"><span>{{ left }}</span></span>
          {%- if right != blank -%}<span class="look__row"><span>{{ right }}</span></span>{%- endif -%}
        </h1>
      </div>
    </div>

    {%- for block in section.blocks -%}
      {%- liquid
        assign c = collections[block.settings.collection]
        assign wide = block.settings.fallback | append: '.webp' | asset_url
        assign tall = block.settings.fallback | append: '-m.webp' | asset_url
        if block.settings.image != blank
          assign wide = block.settings.image | image_url: width: 2400
        endif
        if block.settings.image_mobile != blank
          assign tall = block.settings.image_mobile | image_url: width: 1200
        endif
        assign href = c.url | default: routes.all_products_collection_url
      -%}
      <div class="look__scene" style="--i: {{ forloop.index }}" {{ block.shopify_attributes }}>
        <div class="look__media">
          <picture class="look__fill">
            <source media="(max-width: 760px)" srcset="{{ tall }}">
            <img src="{{ wide }}" alt="{{ block.settings.name | escape }}" loading="lazy" decoding="async" width="2400" height="1350">
          </picture>
        </div>
        <div class="look__copy">
          <p class="look__label">N° {{ forloop.index | prepend: '0' | slice: -2, 2 }} — {{ block.settings.name }}</p>
          <h2 class="look__title"><span class="look__row"><span>{{ block.settings.name | downcase }}</span></span></h2>
          {%- if block.settings.line != blank -%}<p class="look__line">{{ block.settings.line }}</p>{%- endif -%}
          <a class="look__link" href="{{ href }}"><span>Shop {{ block.settings.name }}</span><i aria-hidden="true">→</i></a>
        </div>
      </div>
    {%- endfor -%}

    <nav class="look__index" aria-label="Rooms">
      <button type="button" data-goto="0"><small>00</small><span>{{ section.settings.index_first }}</span></button>
      {%- for block in section.blocks -%}
        <button type="button" data-goto="{{ forloop.index }}"><small>{{ forloop.index | prepend: '0' | slice: -2, 2 }}</small><span>{{ block.settings.name }}</span></button>
      {%- endfor -%}
      <i class="look__bar" aria-hidden="true"></i>
    </nav>
    <p class="look__cue">{{ section.settings.cue }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Hero — the lookbook",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Fall 2026 — Loungewear for living in" },
    { "type": "text", "id": "title", "label": "Title", "info": "Breaks onto two lines at the first full stop.", "default": "wear it. live in it." },
    { "type": "text", "id": "index_first", "label": "Index name for the film", "default": "The haus" },
    { "type": "text", "id": "cue", "label": "Scroll cue", "default": "Scroll to walk through" },
    { "type": "video", "id": "video", "label": "Film", "info": "Optional. Leave empty to use the built-in INN HAUS film." },
    { "type": "image_picker", "id": "poster", "label": "Film poster" }
  ],
  "blocks": [
    {
      "type": "room",
      "name": "Room",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Day In" },
        { "type": "text", "id": "line", "label": "Line", "default": "Curtains half open. Nowhere to be." },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Photo (wide)" },
        { "type": "image_picker", "id": "image_mobile", "label": "Photo (phone, tall)" },
        { "type": "text", "id": "fallback", "label": "Built-in photo", "info": "Theme asset name without .webp", "default": "l-look-dayin" }
      ]
    }
  ],
  "presets": [{ "name": "Hero — the lookbook" }]
}
{% endschema %}
