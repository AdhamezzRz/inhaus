{%- assign blog = section.settings.blog | default: blogs.journal -%}
<section class="journal-teaser" data-header-tone="dark">
  <div class="section-head">
    <p class="t-caps">{{ section.settings.label }}</p>
    <h2 class="t-display" data-split="lines">{{ section.settings.title }}</h2>
    {%- if blog.url -%}<a href="{{ blog.url }}" class="ulink t-caps">Read all entries</a>{%- endif -%}
  </div>
  <div class="jcards">
    {%- for article in blog.articles limit: 3 -%}
      {% render 'article-card', article: article, index: forloop.index0 %}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Journal",
  "settings": [
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "text", "id": "label", "label": "Label", "default": "N° 08 — Notes from the sofa" },
    { "type": "text", "id": "title", "label": "Title", "default": "the journal" }
  ],
  "presets": [{ "name": "Journal" }]
}
{% endschema %}
