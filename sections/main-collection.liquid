{%- liquid
  assign rooms = section.settings.rooms
  assign is_all = false
  if collection.handle == 'all' or collection.handle == blank
    assign is_all = true
  endif
-%}
<section class="shop" data-header-tone="dark" data-section-type="collection">
  <header class="eshop__head">
    <p class="ed-label">{{ collection.products_count }} pieces</p>
    <h1 class="ed-title">{%- if is_all -%}{{ section.settings.all_title }}{%- else -%}{{ collection.title }}{%- endif -%}</h1>
  </header>

  <div class="shopbar">
    <div class="shopbar__rooms" role="tablist" aria-label="Sets">
      <a role="tab" href="{{ routes.all_products_collection_url }}" class="chip{% if is_all %} is-on{% endif %}" data-room-chip="all">All</a>
      {%- for c in rooms -%}
        <a role="tab" href="{{ c.url }}" class="chip{% if collection.handle == c.handle %} is-on{% endif %}" data-room-chip="{{ c.handle }}">{{ c.title | remove_first: 'The ' }}</a>
      {%- endfor -%}
    </div>
    <label class="shopbar__sort">
      <span class="ed-label">Sort</span>
      <select data-sort>
        <option value="edit">Featured</option>
        <option value="low">Price, low to high</option>
        <option value="high">Price, high to low</option>
      </select>
    </label>
  </div>

  {%- paginate collection.products by 48 -%}
    <div class="pgrid" data-grid data-is-all="{{ is_all }}">
      {%- for product in collection.products -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        <p class="shop__empty">Nothing here yet — check back soon.</p>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}
      <nav class="pager" aria-label="Pages">{{ paginate | default_pagination }}</nav>
    {%- endif -%}
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "text", "id": "all_title", "label": "Title for all products", "default": "The collection" },
    { "type": "collection_list", "id": "rooms", "label": "Filter chips", "limit": 6 }
  ]
}
{% endschema %}
