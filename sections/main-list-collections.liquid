<section class="journal" data-header-tone="dark">
  <header class="pagehead">
    <h1 class="ed-title">The sets</h1>
  </header>
  <div class="jcards">
    {%- for c in collections -%}
      {%- unless c.handle == 'frontpage' or c.products_count == 0 -%}
        <a href="{{ c.url }}" class="jcard" data-reveal>
          <span class="jcard__img">
            {%- if c.featured_image -%}{{ c.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}
          </span>
          <span class="jcard__meta"><span>{{ c.products_count }} pieces</span></span>
          <span class="jcard__title">{{ c.title }}</span>
          
        </a>
      {%- endunless -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{ "name": "Collections list" }
{% endschema %}
