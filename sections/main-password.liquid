<section class="soon">
  <div class="soon__pattern" aria-hidden="true"></div>
  <div class="soon__mark">{% render 'wordmark' %}</div>
  <p class="soon__tag">WEAR IT. LIVE IN IT.</p>
  <h1 class="t-display">{{ section.settings.title }}</h1>
  <p class="soon__text">{{ shop.password_message | default: section.settings.text }}</p>
  {%- form 'customer', class: 'tagform' -%}
    <input type="hidden" name="contact[tags]" value="newsletter, launch-list">
    <span class="tagform__hole" aria-hidden="true"></span>
    <label for="soon-email" class="sr-only">Email</label>
    <input id="soon-email" type="email" name="contact[email]" required placeholder="your@email.com">
    <button type="submit" class="tagform__btn">Notify me</button>
    {%- if form.posted_successfully? -%}<p class="footer__ok tagform__msg">You’re on the list. See you inside.</p>{%- endif -%}
  {%- endform -%}
  <details class="soon__owner">
    <summary class="t-caps">Store owner?</summary>
    {%- form 'storefront_password', class: 'tagform' -%}
      <span class="tagform__hole" aria-hidden="true"></span>
      <label for="soon-pw" class="sr-only">Password</label>
      <input id="soon-pw" type="password" name="password" placeholder="Password" autocomplete="current-password">
      <button type="submit" class="tagform__btn">Enter</button>
    {%- endform -%}
  </details>
</section>

{% schema %}
{
  "name": "Opening soon",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "the doors open soon" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "We’re folding the last pieces into their linen pouches. Leave your email and we’ll let you in first." }
  ]
}
{% endschema %}
