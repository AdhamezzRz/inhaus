{%- liquid
  assign tag = 'l-wrap-tag.webp' | asset_url
  assign card = 'l-wrap-card.webp' | asset_url
  assign pouch = 'l-wrap-pouch.webp' | asset_url
  if section.settings.image_tag != blank
    assign tag = section.settings.image_tag | image_url: width: 820
  endif
  if section.settings.image_card != blank
    assign card = section.settings.image_card | image_url: width: 820
  endif
  if section.settings.image_pouch != blank
    assign pouch = section.settings.image_pouch | image_url: width: 820
  endif
-%}
<section class="wrap" data-header-tone="dark" id="packaging">
  <header class="wrap__head" data-reveal>
    <p class="t-caps">{{ section.settings.label }}</p>
    <h2 class="t-display">{{ section.settings.title }}</h2>
    {%- if section.settings.text != blank -%}<p class="wrap__line">{{ section.settings.text }}</p>{%- endif -%}
  </header>

  <div class="wrap__row">
    <figure class="wrap__item" data-reveal>
      <div class="wrap__shot"><img src="{{ tag }}" alt="INN HAUS hang tag: wear it. live in it." loading="lazy" width="820" height="1025"></div>
      <figcaption><small>01</small>{{ section.settings.tag_caption }}</figcaption>
    </figure>

    <figure class="wrap__item wrap__item--card" data-reveal data-delay="0.12">
      <button type="button" class="wrap__flip" data-flip aria-pressed="false" aria-label="Turn the thank you card over">
        <span class="wrap__face wrap__face--front"><img src="{{ card }}" alt="INN HAUS thank you card tied with sage ribbon" loading="lazy" width="820" height="1025"></span>
        <span class="wrap__face wrap__face--back">
          <span class="wrap__note t-display">{{ section.settings.note }}</span>
          <span class="wrap__sign">{% render 'wordmark' %}</span>
        </span>
      </button>
      <figcaption><small>02</small>{{ section.settings.card_caption }} <em>· {{ section.settings.flip_hint }}</em></figcaption>
    </figure>

    <figure class="wrap__item" data-reveal data-delay="0.24">
      <div class="wrap__shot"><img src="{{ pouch }}" alt="Sage linen INN HAUS pouches tied with black satin ribbon" loading="lazy" width="820" height="1025"></div>
      <figcaption><small>03</small>{{ section.settings.pouch_caption }}</figcaption>
    </figure>
  </div>
</section>

{% schema %}
{
  "name": "Unboxing",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "N° 06 — The unboxing" },
    { "type": "text", "id": "title", "label": "Title", "default": "wrapped like a gift" },
    { "type": "text", "id": "text", "label": "Line", "default": "Folded by hand. The pouch is yours to keep." },
    { "type": "image_picker", "id": "image_tag", "label": "Tag photo" },
    { "type": "text", "id": "tag_caption", "label": "Tag caption", "default": "The tag" },
    { "type": "image_picker", "id": "image_card", "label": "Card photo" },
    { "type": "text", "id": "card_caption", "label": "Card caption", "default": "The card" },
    { "type": "text", "id": "flip_hint", "label": "Card hint", "default": "tap to turn" },
    { "type": "text", "id": "note", "label": "Note on the back of the card", "default": "for slow mornings and long weekends — with love" },
    { "type": "image_picker", "id": "image_pouch", "label": "Pouch photo" },
    { "type": "text", "id": "pouch_caption", "label": "Pouch caption", "default": "The pouch" }
  ],
  "presets": [{ "name": "Unboxing" }]
}
{% endschema %}
