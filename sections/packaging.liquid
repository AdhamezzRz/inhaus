{%- liquid
  assign photo = 'l-packaging.webp' | asset_url
  if section.settings.image != blank
    assign photo = section.settings.image | image_url: width: 800
  endif
-%}
<section class="pack" data-header-tone="dark" id="packaging">
  <div class="pack__pin">
    <div class="pack__copy" data-reveal>
      <p class="t-caps">{{ section.settings.label }}</p>
      <h2 class="t-display">{{ section.settings.title }}</h2>
      <p>{{ section.settings.text }}</p>
      <ol class="pack__steps">
        {%- for block in section.blocks -%}
          <li class="pack__step" {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
        {%- endfor -%}
      </ol>
    </div>

    <svg class="pack__scene" viewBox="0 0 600 640" aria-hidden="true" data-reveal data-delay="0.15">
      <defs>
        <pattern id="linen-{{ section.id }}" width="6" height="6" patternUnits="userSpaceOnUse">
          <rect width="6" height="6" fill="#737B5B"/>
          <path d="M0 3 H6 M3 0 V6" stroke="#6A7253" stroke-width="0.8"/>
        </pattern>
      </defs>
      <g class="pk-card">
        <path d="M170 120 q15 -14 30 0 q15 -14 30 0 q15 -14 30 0 q15 -14 30 0 q15 -14 30 0 q15 -14 30 0 q15 -14 30 0 q15 -14 30 0 V330 q-15 14 -30 0 q-15 14 -30 0 q-15 14 -30 0 q-15 14 -30 0 q-15 14 -30 0 q-15 14 -30 0 q-15 14 -30 0 q-15 14 -30 0 Z" fill="#F3F0E9" stroke="#E2DACB"/>
        <text x="290" y="190" text-anchor="middle" class="pk-card__title">THANK YOU</text>
        <text x="290" y="212" text-anchor="middle" class="pk-card__sub">WE HOPE YOU LOVE YOUR ORDER</text>
        <g transform="translate(232 232) scale(0.13)" fill="#737B5B"><use href="#ih-logo" width="900" height="463"/></g>
      </g>
      <g class="pk-pouch">
        <rect x="110" y="250" width="380" height="330" rx="10" fill="url(#linen-{{ section.id }})"/>
        <rect x="124" y="264" width="352" height="302" rx="6" fill="none" stroke="#C9CDB6" stroke-dasharray="6 6" stroke-width="1.4"/>
        <g transform="translate(240 470) scale(0.135)" fill="#E9E6D8" opacity="0.9"><use href="#ih-logo" width="900" height="463"/></g>
        <text x="300" y="548" text-anchor="middle" class="pk-pouch__tag">WEAR IT. LIVE IN IT.</text>
      </g>
      <path class="pk-flap" d="M110 250 H490 V330 Q300 372 110 330 Z" fill="#6A7253"/>
      <path class="pk-ribbon" d="M300 250 V580" stroke="#141110" stroke-width="12" fill="none"/>
      <path class="pk-ribbon" d="M110 360 H490" stroke="#141110" stroke-width="12" fill="none"/>
      <path class="pk-bow" d="M300 330 C 240 260, 180 300, 214 336 C 236 360, 280 344, 300 330" stroke="#141110" stroke-width="10" fill="none" stroke-linecap="round"/>
      <path class="pk-bow" d="M300 330 C 360 260, 420 300, 386 336 C 364 360, 320 344, 300 330" stroke="#141110" stroke-width="10" fill="none" stroke-linecap="round"/>
      <path class="pk-bow" d="M300 330 C 286 370, 262 404, 238 430" stroke="#141110" stroke-width="9" fill="none" stroke-linecap="round"/>
      <path class="pk-bow" d="M300 330 C 314 370, 340 404, 364 430" stroke="#141110" stroke-width="9" fill="none" stroke-linecap="round"/>
      <rect class="pk-knot" x="288" y="318" width="24" height="24" rx="7" fill="#141110"/>
      <g class="pk-tag" style="transform-origin: 300px 330px">
        <path d="M300 330 C 330 380, 400 400, 420 420" stroke="#E8E0CF" stroke-width="2" fill="none"/>
        <g transform="translate(400 410) rotate(-12)">
          <rect width="82" height="118" rx="6" fill="#F3F0E9" stroke="#E2DACB"/>
          <circle cx="41" cy="14" r="5" fill="#E2DACB"/>
          <text x="41" y="56" text-anchor="middle" class="pk-tag__text">WEAR IT.</text>
          <text x="41" y="72" text-anchor="middle" class="pk-tag__text">LIVE IN IT.</text>
          <g transform="translate(16 84) scale(0.056)" fill="#A9A08F"><use href="#ih-logo" width="900" height="463"/></g>
        </g>
      </g>
    </svg>

    <figure class="pack__photo">
      <img src="{{ photo }}" alt="Sage linen pouches tied with black satin ribbon" loading="lazy" width="896" height="1120">
    </figure>
  </div>
</section>

{% schema %}
{
  "name": "Unboxing",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "N° 06 — The unboxing" },
    { "type": "text", "id": "title", "label": "Title", "default": "wrapped like a gift" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Every order is folded by hand, tucked into a sage linen pouch, tied with a black satin ribbon and finished with a hand-written thank you card. The pouch is yours to keep." },
    { "type": "image_picker", "id": "image", "label": "Photo" }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Folded by hand" }] }
  ],
  "presets": [{ "name": "Unboxing", "blocks": [
    { "type": "step", "settings": { "text": "Folded by hand" } },
    { "type": "step", "settings": { "text": "Tucked in sage linen" } },
    { "type": "step", "settings": { "text": "Tied with black satin" } },
    { "type": "step", "settings": { "text": "Signed, with a thank you" } }
  ] }]
}
{% endschema %}
