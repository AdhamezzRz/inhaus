{%- liquid
  assign xs = '4,24,44,63,80,12,34,56,76' | split: ','
  assign ys = '12,2,16,4,18,50,54,48,56' | split: ','
  assign rs = '-7,5,-3,8,-6,4,-9,6,-4' | split: ','
  assign mxs = '4,50,4,50,4,50,4,50,27' | split: ','
  assign mys = '0,3,20,23,40,43,60,63,79' | split: ','
-%}
<section class="polaroids" data-header-tone="dark">
  <div class="polaroids__head" data-reveal>
    <p class="t-caps">{{ section.settings.label }}</p>
    <h2 class="t-display" data-reveal>{{ section.settings.title }}</h2>
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
  </div>
  <div class="polaroids__table">
    {%- for block in section.blocks limit: 9 -%}
      {%- assign i = forloop.index0 -%}
      <figure
        class="polaroid polaroid--{{ block.settings.frame }}"
        style="left: {{ xs[i] }}%; top: {{ ys[i] }}%; rotate: {{ rs[i] }}deg; --mx: {{ mxs[i] }}%; --my: {{ mys[i] }}%;"
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: '', draggable: 'false' }}
        {%- else -%}
          <img src="{{ block.settings.fallback | asset_url }}" alt="" loading="lazy" draggable="false" width="880" height="1168">
        {%- endif -%}
        <figcaption>{{ block.settings.caption }}</figcaption>
      </figure>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Haus diary (polaroids)",
  "max_blocks": 9,
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "N° 05 — Camera roll" },
    { "type": "text", "id": "title", "label": "Title", "default": "the haus diary" },
    { "type": "text", "id": "text", "label": "Text", "default": "Not a photoshoot." }
  ],
  "blocks": [
    { "type": "polaroid", "name": "Polaroid", "settings": [
      { "type": "image_picker", "id": "image", "label": "Photo" },
      { "type": "text", "id": "fallback", "label": "Fallback photo (theme asset)", "default": "l-cafe.webp" },
      { "type": "text", "id": "caption", "label": "Caption", "default": "day in" },
      { "type": "select", "id": "frame", "label": "Frame", "default": "sage", "options": [
        { "value": "sage", "label": "Sage" }, { "value": "burgundy", "label": "Burgundy" }, { "value": "blue", "label": "Dusty blue" }, { "value": "cream", "label": "Cream" }
      ] }
    ] }
  ],
  "presets": [{ "name": "Haus diary (polaroids)" }]
}
{% endschema %}
