{%- assign shown = 0 -%}
<section class="erow erow--related" data-header-tone="dark">
  <header class="erow__head" data-reveal>
    <h2 class="ed-label">{{ section.settings.title }}</h2>
    <a class="ed-link" href="{{ routes.all_products_collection_url }}">View all</a>
  </header>
  <div class="erow__track">
    {%- for p in collections.all.products limit: 50 -%}
      {%- if p.id != product.id and p.type != product.type and shown < 5 -%}
        {% render 'product-card', product: p, sizes: '(max-width: 760px) 62vw, 20vw' %}
        {%- assign shown = shown | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Related products",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "You may also like" }
  ]
}
{% endschema %}
