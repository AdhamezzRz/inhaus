<section class="rooms" data-header-tone="dark" id="rooms">
  <div class="section-head" data-reveal>
    <p class="t-caps">{{ section.settings.label }}</p>
    <h2 class="t-display">{{ section.settings.title }}</h2>
  </div>
  <div class="rooms__row">
    {%- for block in section.blocks -%}
      {%- assign c = block.settings.collection -%}
      <a href="{{ c.url | default: routes.all_products_collection_url }}" class="room" data-reveal data-delay="{{ forloop.index0 | times: 0.12 }}" {{ block.shopify_attributes }}>
        <span class="room__arch">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450,700,900', sizes: '(max-width: 860px) 80vw, 30vw', alt: '' }}
          {%- else -%}
            <img src="{{ block.settings.fallback | asset_url }}" alt="" loading="lazy" width="880" height="1168">
          {%- endif -%}
        </span>
        <span class="room__num t-caps">Room {{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
        <span class="room__name">{{ block.settings.name | default: c.title }}</span>
        <span class="room__line">{{ block.settings.line }}</span>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Rooms",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "N° 03 — Walk through the haus" },
    { "type": "text", "id": "title", "label": "Title", "default": "every room has a uniform" }
  ],
  "blocks": [
    {
      "type": "room",
      "name": "Room",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "line", "label": "One-liner" },
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "fallback", "label": "Fallback photo (theme asset)", "default": "l-stretch.webp" }
      ]
    }
  ],
  "presets": [{ "name": "Rooms" }]
}
{% endschema %}
