{%- comment -%}
  A quiet product card: photo (second photo on hover), name and price on one line, colour underneath.
  {% render 'product-card', product: product %}
{%- endcomment -%}
{%- liquid
  assign colour = product.metafields.inhaus.color_name.value
  assign name = product.title | split: ' — ' | first
  assign style_key = ''
  for c in product.collections
    if c.handle contains '-sets'
      assign style_key = c.handle
    endif
  endfor
  assign alt_media = product.media[1]
  assign img_sizes = sizes | default: '(max-width: 760px) 50vw, 25vw'
-%}
<article class="card" data-room="{{ style_key }}" data-price="{{ product.price }}">
  <a href="{{ product.url }}" class="card__link">
    <span class="card__frame">
      {%- if product.featured_media -%}
        {{ product.featured_media | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '360,540,720,1000', sizes: img_sizes, alt: product.featured_media.alt, class: 'card__img' }}
      {%- endif -%}
      {%- if alt_media -%}
        {{ alt_media | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '360,540,720,1000', sizes: img_sizes, alt: '', class: 'card__alt' }}
      {%- endif -%}
    </span>
    <span class="card__meta">
      <span class="card__name">{{ name }}</span>
      <span class="card__price">{%- if product.available -%}{{ product.price | money_without_trailing_zeros }}{%- else -%}Sold out{%- endif -%}</span>
    </span>
    {%- if colour != blank -%}<span class="card__colour">{{ colour }}</span>{%- endif -%}
  </a>
</article>
