{%- comment -%}
  The wordmark. Pass write: true to add the pen mask that writes it stroke by stroke
  (the .wordmark__pen paths use pathLength="1"; animate stroke-dashoffset 1 → 0).
  Pass a unique uid when write is true.
  Usage: {% render "wordmark", write: true, uid: "footer", class: "footer__mark" %}
{%- endcomment -%}
{%- assign mask_id = "wm-" | append: uid -%}
<svg class="wordmark{% if write %} wordmark--write{% endif %} {{ class }}" viewBox="0 0 900 463" role="img" aria-label="inn haus" fill="currentColor">
  {%- if write -%}
    <defs><mask id="{{ mask_id }}" maskUnits="userSpaceOnUse" x="0" y="0" width="900" height="463"><g class="wordmark__pen" fill="none" stroke="#fff" stroke-width="38" stroke-linecap="round" stroke-linejoin="round"><path pathLength="1" d="M 118 52 L 152 18 M 96 92 L 21 255 L 40 252 L 100 190 L 160 135 L 222 82 L 206 104 L 172 182 L 214 127 L 280 75 L 274 98 L 276 140 L 292 148 L 334 120 L 372 62 L 367 88 L 335 146 L 372 98 L 412 58 L 456 30 L 442 58 L 424 112 L 432 140 L 450 150 C 560 130, 700 72, 886 31"/><path pathLength="1" d="M 248 168 L 82 442 M 130 372 L 186 318 L 236 282 L 230 312 L 212 375 L 214 404 L 232 410 L 270 380 L 302 346 L 330 308 L 352 282 L 386 268 L 402 290 L 376 318 L 340 352 L 312 376 L 304 382 L 330 372 L 378 326 L 416 280 L 400 318 L 382 356 L 396 382 L 420 362 L 460 320 L 502 276 L 510 268 L 498 292 L 478 332 L 474 352 L 484 358 L 522 322 L 570 265 L 556 300 L 540 344 L 552 366 L 590 346 L 630 304 L 652 278 L 676 234 L 720 198 L 700 212 L 676 244 L 670 270 L 690 296 L 720 316 L 728 336 L 712 376 L 676 412 L 640 436 L 614 444 L 610 428 L 640 388 L 690 352 L 712 340"/></g></mask></defs>
    <g mask="url(#{{ mask_id }})"><use href="#ih-logo" width="900" height="463"/></g>
  {%- else -%}
    <use href="#ih-logo" width="900" height="463"/>
  {%- endif -%}
</svg>
