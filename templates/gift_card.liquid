{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Your {{ shop.name }} gift card</title>
    {{ 'inhaus.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    {{ content_for_header }}
  </head>
  <body class="template-gift-card">
    {% render 'wordmark-sprite' %}
    <section class="soon">
      <div class="soon__mark">{% render 'wordmark' %}</div>
      <h1 class="t-display">a gift for you</h1>
      <p class="soon__text">{{ gift_card.initial_value | money }} to spend on soft things.</p>
      <p class="giftcode">{{ gift_card.code | format_code }}</p>
      {%- if gift_card.expired -%}<p>This gift card expired on {{ gift_card.expires_on | date: '%-d %B %Y' }}.</p>{%- endif -%}
      {%- if gift_card.balance != gift_card.initial_value -%}<p>Remaining balance: {{ gift_card.balance | money }}</p>{%- endif -%}
      <div id="QrCode" data-identifier="{{ gift_card.qr_identifier }}"></div>
      <a href="{{ shop.url }}" class="btn btn--sage"><span>Start shopping</span></a>
    </section>
    <script>
      window.addEventListener('load', function () {
        var el = document.getElementById('QrCode');
        if (window.QRCode && el) new QRCode(el, { text: el.dataset.identifier, width: 120, height: 120 });
      });
    </script>
  </body>
</html>
